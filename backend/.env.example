# PostgreSQL connection string
# Local:     postgresql://postgres:postgres@localhost:5432/erp_crm
# Supabase/Neon/Render: use the connection string they provide
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_crm"

# Secret used to sign JWTs - change this to a long random string in production
JWT_SECRET="replace-this-with-a-long-random-secret"

# Port the API server listens on
PORT=4000
